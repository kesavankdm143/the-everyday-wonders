---
// Phone-only bar fixed to the bottom of the screen.
import Icon from './Icon.astro';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** True on the homepage, where the bar jumps to blocks on the same page. */
  isHome?: boolean;
  /** The section being viewed (e.g. "markets"), so its tab can be highlighted. */
  current?: string;
}
const { lang, isHome = true, current } = Astro.props;
const t = useTranslations(lang);

// Away from the homepage those blocks live on the homepage, so link back to them.
const home = `/${lang}/`;
const marketsHref = isHome ? '#markets' : `${home}markets/`;
const articlesHref = isHome ? '#latest' : `${home}#latest`;
const topicsHref = isHome ? '#topics' : `${home}#topics`;
const onMarkets = current === 'markets';
---

<nav class="bottom-nav" aria-label={t('bottom.label')}>
  <a href={home} class={isHome ? 'active' : undefined} aria-current={isHome ? 'page' : undefined}><Icon name="home" size={22} /><span>{t('bottom.home')}</span></a>
  <a href={marketsHref} class={onMarkets ? 'active' : undefined} aria-current={onMarkets ? 'page' : undefined}><Icon name="markets" size={22} /><span>{t('bottom.markets')}</span></a>
  <a href={articlesHref}><Icon name="articles" size={22} /><span>{t('bottom.articles')}</span></a>
  <a href={topicsHref}><Icon name="topics" size={22} /><span>{t('bottom.topics')}</span></a>
  <button type="button" data-open-menu><Icon name="menu" size={22} /><span>{t('bottom.menu')}</span></button>
</nav>

<script>
  document.querySelector('[data-open-menu]')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('ew:open-menu'));
  });
</script>

<style>
  .bottom-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    height: calc(var(--bottom-nav-h) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: rgba(255, 255, 255, 0.97);
    border-top: 1px solid var(--line);
    box-shadow: 0 -6px 20px rgba(15, 27, 51, 0.08);
  }
  a,
  button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    min-width: 0;
  }
  span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .active {
    color: var(--blue);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .bottom-nav {
      display: none;
    }
  }
</style>
