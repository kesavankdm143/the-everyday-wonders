---
import Icon from './Icon.astro';
import { exploreCategories, categoryLabel } from '../data/home';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="panel" id="topics" aria-labelledby="cat-title">
  <div class="section-head">
    <h2 id="cat-title">{t('categories.title')}</h2>
    <a class="view-all" href={`/${lang}/topics/`}>{t('viewAll')} <Icon name="arrow" size={15} /></a>
  </div>
  <ul class="cats">
    {
      exploreCategories.map((c) => (
        <li>
          <a class="cat" href={`/${lang}/${c.key}/`}>
            <img src={c.image} alt="" width="400" height="400" loading="lazy" decoding="async" />
            <span class="cat-label">{categoryLabel[c.key][lang]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .cat {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--navy-800);
    box-shadow: var(--shadow);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .cat img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .cat::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 11, 29, 0.88) 0%, rgba(5, 11, 29, 0.15) 50%, rgba(5, 11, 29, 0) 70%);
  }
  .cat-label {
    position: absolute;
    left: 10px;
    right: 8px;
    bottom: 8px;
    z-index: 1;
    color: #fff;
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.3;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .cat:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  .cat:hover img {
    transform: scale(1.06);
  }

  @media (min-width: 600px) {
    .cat-label {
      font-size: 1rem;
      left: 14px;
      bottom: 12px;
    }
    .cat {
      aspect-ratio: 4 / 3;
    }
  }
  @media (min-width: 1200px) {
    .cats {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .cat {
      aspect-ratio: 3 / 4;
    }
    .cat-label {
      font-size: 0.95rem;
      left: 12px;
    }
  }
</style>
