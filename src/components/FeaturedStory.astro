---
import Icon from './Icon.astro';
import { featured, categoryLabel } from '../data/home';
import { type Lang, useTranslations, otherLang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const a = featured;
const href = `/${lang}/articles/${a.slug}/`;
---

<article class="featured">
  <img
    class="featured-img"
    src={a.image}
    alt=""
    width="1600"
    height="900"
    fetchpriority="high"
    decoding="async"
  />
  <div class="featured-shade" aria-hidden="true"></div>
  <div class="featured-body">
    <div class="featured-meta">
      <span class="chip chip-gold">{t('featured.label')}</span>
      <span class="chip chip-glass">{categoryLabel[a.category][lang]}</span>
      <span class="chip chip-glass">{t('sample')}</span>
    </div>
    <h2 class="featured-title">
      <a class="stretched" href={href}>{a.title[lang]}</a>
    </h2>
    <p class="featured-sub" lang={other}>{a.title[other]}</p>
    {a.summary && <p class="featured-summary">{a.summary[lang]}</p>}
    <span class="btn-read" aria-hidden="true">
      {t('readNow')}
      <Icon name="arrow" size={18} />
    </span>
  </div>
</article>

<style>
  .featured {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 380px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--navy-900);
    box-shadow: var(--shadow);
    color: #fff;
  }
  .featured-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 40%;
    z-index: -2;
    transition: transform 0.6s ease;
  }
  .featured:hover .featured-img {
    transform: scale(1.03);
  }
  .featured-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(5, 11, 29, 0.94) 0%, rgba(5, 11, 29, 0.6) 42%, rgba(5, 11, 29, 0) 72%),
      linear-gradient(to right, rgba(5, 11, 29, 0.45), rgba(5, 11, 29, 0) 60%);
  }
  .featured-body {
    padding: 20px;
    max-width: 720px;
  }
  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }
  .chip-gold {
    background: var(--gold);
    color: var(--navy-950);
  }
  .chip-glass {
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
  }
  .featured-title {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }
  .featured-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 5px;
  }
  .featured-sub {
    margin-top: 6px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--gold-light);
    line-height: 1.45;
  }
  .featured-summary {
    display: none;
    margin-top: 10px;
    color: #d6deef;
    font-size: 0.98rem;
  }
  .btn-read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 10px 20px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--gold-light), var(--gold));
    color: var(--navy-950);
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 6px 18px rgba(217, 180, 90, 0.35);
    transition: transform 0.2s;
  }
  .featured:hover .btn-read {
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .featured {
      min-height: 440px;
    }
    .featured-body {
      padding: 32px;
    }
    .featured-title {
      font-size: 2.4rem;
    }
    .featured-sub {
      font-size: 1.45rem;
    }
    .featured-summary {
      display: block;
    }
  }
  @media (min-width: 1100px) {
    .featured {
      min-height: 100%;
    }
  }
</style>
