---
// A plain text page (About, Contact, Privacy Policy, Disclaimer). The wording lives
// in src/data/pages.ts; this only lays it out.
import PageFrame from './PageFrame.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { infoPages, pagesUpdated, contactEmail, type PageKey } from '../data/pages';
import { type Lang, useTranslations, otherLang, formatDate } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const data = infoPages[page];
const updated = new Date(pagesUpdated);
---

<PageFrame
  lang={lang}
  title={`${data.title[lang]} — The Everyday Wonders`}
  description={data.description[lang]}
  path={`${page}/`}
  active="info"
>
  <Breadcrumbs
    lang={lang}
    items={[{ label: t('nav.home'), href: `/${lang}/` }, { label: data.title[lang] }]}
  />

  <article class="info">
    <header>
      <h1>{data.title[lang]}</h1>
      <p class="sub" lang={other}>{data.title[other]}</p>
      <p class="meta">
        {t('page.updated')}: <time datetime={pagesUpdated}>{formatDate(updated, lang)}</time>
      </p>
    </header>

    <div class="prose">
      {
        data.blocks.map((b) =>
          b.type === 'h2' ? (
            <h2>{b.text[lang]}</h2>
          ) : b.type === 'p' ? (
            <p>{b.text[lang]}</p>
          ) : b.type === 'email' ? (
            <p class="email">
              {b.label[lang]}: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            </p>
          ) : (
            <ul>
              {b.items.map((item) => (
                <li>{item[lang]}</li>
              ))}
            </ul>
          ),
        )
      }
    </div>
  </article>
</PageFrame>

<style>
  .info {
    width: 100%;
    max-width: 820px;
    margin-inline: auto;
    padding: 20px 18px 26px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  h1 {
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .sub {
    margin-top: 2px;
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--muted);
  }
  .meta {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .prose {
    margin-top: 18px;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose :global(p) {
    margin: 0 0 1.1em;
  }
  .prose :global(h2) {
    margin: 1.6em 0 0.5em;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .prose :global(.email) {
    font-size: 1.15rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .prose :global(.email a) {
    color: var(--blue);
    text-decoration: underline;
  }
  .prose :global(ul) {
    margin: 0 0 1.2em;
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-bottom: 0.45em;
  }
  .prose :global(li::marker) {
    color: var(--gold-ink);
  }

  @media (min-width: 768px) {
    .info {
      padding: 36px 44px 40px;
    }
    h1 {
      font-size: 2.3rem;
    }
    .prose {
      font-size: 1.1rem;
    }
    .prose :global(h2) {
      font-size: 1.45rem;
    }
  }
</style>
