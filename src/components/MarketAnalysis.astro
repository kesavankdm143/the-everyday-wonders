---
import Icon from './Icon.astro';
import { marketAnalysis } from '../data/home';
import { articleHref } from '../data/articleFiles';
import { type Lang, useTranslations, otherLang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const a = marketAnalysis;
---

<section class="panel analysis" aria-labelledby="analysis-title">
  <div class="section-head">
    <h2 id="analysis-title">{t('analysis.title')}</h2>
    <a class="view-all" href={`/${lang}/markets/`}>{t('viewAll')} <Icon name="arrow" size={15} /></a>
  </div>
  <article class="analysis-card">
    <img src={a.image} alt="" width="400" height="400" loading="lazy" decoding="async" />
    <div class="analysis-body">
      <h3><a class="stretched" href={articleHref(lang, a.slug)}>{a.title[lang]}</a></h3>
      <p class="sub" lang={other}>{a.title[other]}</p>
      {a.summary && <p class="summary">{a.summary[lang]}</p>}
      <span class="btn-green" aria-hidden="true">{t('analysis.cta')} <Icon name="arrow" size={16} /></span>
    </div>
  </article>
</section>

<style>
  .analysis-card {
    position: relative;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 14px;
    align-items: start;
  }
  .analysis-card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .analysis-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }
  h3 {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.35;
  }
  h3 a:hover {
    color: var(--blue);
  }
  .sub {
    font-size: 0.85rem;
    color: var(--muted);
  }
  /* A long unbroken word (common in Tamil) wraps instead of widening the page */
  h3,
  .sub,
  .summary {
    overflow-wrap: anywhere;
  }
  @media (max-width: 359px) {
    .analysis-card {
      grid-template-columns: 88px 1fr;
      gap: 12px;
    }
  }
  .summary {
    display: none;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .btn-green {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--green);
    color: #fff;
    font-size: 0.86rem;
    font-weight: 600;
    max-width: 100%;
  }
  .analysis-card:hover .btn-green {
    background: #0b6236;
  }

  @media (min-width: 600px) {
    .analysis-card {
      grid-template-columns: 160px 1fr;
    }
    .summary {
      display: block;
    }
  }
  @media (min-width: 1100px) {
    .analysis-card {
      grid-template-columns: 130px 1fr;
    }
    .summary {
      display: none;
    }
  }
</style>
