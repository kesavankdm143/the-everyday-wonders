---
// One section page (Science, Space, …). /en/<section>/ and /ta/<section>/ both
// use this, so all eight sections share one design and only the content differs.
// The article cards link to the real articles. The market figures on the Markets
// page are SAMPLE data and are labelled that way on screen.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SectionHero from './SectionHero.astro';
import MarketStrip from './MarketStrip.astro';
import ArticleCard from './ArticleCard.astro';
import SectionLinks from './SectionLinks.astro';
import SiteFooter from './SiteFooter.astro';
import BottomNav from './BottomNav.astro';
import Icon from './Icon.astro';
import { type CategoryKey, categoryLabel, financeTopics } from '../data/home';
import { sections } from '../data/sections';
import { articlesFor, getDek } from '../data/articles';
import { articleHref } from '../data/articleFiles';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  section: CategoryKey;
}
const { lang, section } = Astro.props;
const t = useTranslations(lang);

const articles = await Promise.all(
  articlesFor(section).map(async (article) => ({ article, dek: await getDek(article.slug, lang) })),
);
const isMarkets = section === 'markets';
const title = `${categoryLabel[section][lang]} — The Everyday Wonders`;
---

<BaseLayout lang={lang} title={title} description={sections[section].description[lang]} path={`${section}/`}>
  <SiteHeader lang={lang} active={section} />

  <main id="main" class="container page">
    {
      isMarkets && (
        <p class="note" role="note">
          <Icon name="info" size={18} />
          <span>{t('preview.note')}</span>
        </p>
      )
    }

    <SectionHero lang={lang} section={section} />

    {
      isMarkets && (
        <>
          <MarketStrip lang={lang} />
          <p class="note" role="note">
            <Icon name="info" size={18} />
            <span>{t('footer.finance')}</span>
          </p>
        </>
      )
    }

    <section class="panel" aria-labelledby="articles-title">
      <div class="section-head">
        <h2 id="articles-title">{t('section.articles')}</h2>
      </div>
      {
        articles.length > 0 ? (
          <ul class="grid">
            {articles.map(({ article, dek }) => (
              <li>
                <ArticleCard
                  lang={lang}
                  title={article.title}
                  image={article.image}
                  href={articleHref(lang, article.slug)}
                  summary={dek}
                  minutes={article.minutes}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">{t('section.empty')}</p>
        )
      }
    </section>

    {
      isMarkets && (
        <section class="panel" aria-labelledby="topics-title">
          <div class="section-head">
            <h2 id="topics-title">{t('finance.title')}</h2>
          </div>
          <ul class="grid">
            {financeTopics.map((f) => (
              <li>
                <ArticleCard lang={lang} title={f.title} image={f.image} summary={f.desc[lang]} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <SectionLinks lang={lang} current={section} />
  </main>

  <SiteFooter lang={lang} />
  <BottomNav lang={lang} isHome={false} current={section} />
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 16px;
  }
  .note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: #fff8e2;
    border: 1px solid #f0dc9e;
    color: #5e4710;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .note :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .empty {
    padding: 8px 2px 4px;
    color: var(--muted);
  }

  /* Room for the phone bottom bar so it never covers the footer */
  @media (max-width: 767px) {
    :global(body) {
      padding-bottom: calc(var(--bottom-nav-h) + env(safe-area-inset-bottom));
    }
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }
  @media (min-width: 768px) {
    .page {
      gap: 28px;
      padding-top: 22px;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }
</style>
