---
// One "Money & Markets" guide. Text arrives through the slot (from Markdown).
// Any market figures shown are SAMPLE data and are labelled as such.
import PageFrame from './PageFrame.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleCard from './ArticleCard.astro';
import MarketStrip from './MarketStrip.astro';
import Icon from './Icon.astro';
import { type Article, categoryLabel } from '../data/home';
import { articleHref } from '../data/articleFiles';
import type { MarketItem, Bi } from '../data/home';
import { type Lang, useTranslations, otherLang, formatDate } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
  title: Bi;
  image: string;
  dek: string;
  updated: Date;
  markets: MarketItem['icon'][];
  related: { article: Article; dek: string }[];
  available: Lang[];
  switchTo?: Partial<Record<Lang, string>>;
}
const { lang, slug, title, image, dek, updated, markets, related, available, switchTo } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const iso = updated.toISOString().slice(0, 10);
---

<PageFrame
  lang={lang}
  title={`${title[lang]} — The Everyday Wonders`}
  description={dek}
  path={`markets/${slug}/`}
  active="markets"
  available={available}
  switchTo={switchTo}
>
  <Breadcrumbs
    lang={lang}
    items={[
      { label: t('nav.home'), href: `/${lang}/` },
      { label: categoryLabel.markets[lang], href: `/${lang}/markets/` },
      { label: title[lang] },
    ]}
  />

  <article class="article">
    <header class="head">
      <a class="kicker" href={`/${lang}/markets/`}>{t('finance.title')}</a>
      <h1>{title[lang]}</h1>
      <p class="sub" lang={other}>{title[other]}</p>
      <p class="dek">{dek}</p>
      <p class="meta">{t('page.updated')}: <time datetime={iso}>{formatDate(updated, lang)}</time></p>
    </header>

    <img class="cover" src={image} alt="" width="400" height="400" fetchpriority="high" decoding="async" />

    <div class="prose"><slot /></div>

    <p class="note" role="note">
      <Icon name="info" size={18} />
      <span>{t('footer.finance')}</span>
    </p>
  </article>

  {markets.length > 0 && <MarketStrip lang={lang} only={markets} />}

  {
    related.length > 0 && (
      <section class="panel" aria-labelledby="related-title">
        <div class="section-head">
          <h2 id="related-title">{t('article.related')}</h2>
          <a class="view-all" href={`/${lang}/markets/`}>{t('viewAll')} <Icon name="arrow" size={15} /></a>
        </div>
        <ul class="grid">
          {related.map((r) => (
            <li>
              <ArticleCard
                lang={lang}
                title={r.article.title}
                image={r.article.image}
                href={articleHref(lang, r.article.slug)}
                kicker={categoryLabel[r.article.category][lang]}
                summary={r.dek}
                minutes={r.article.minutes}
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</PageFrame>

<style>
  .article {
    width: 100%;
    max-width: 820px;
    margin-inline: auto;
    padding: 20px 18px 24px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .kicker {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--gold-ink);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  h1 {
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .sub {
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--muted);
  }
  .dek {
    margin-top: 6px;
    font-size: 1.08rem;
    color: #2b3957;
  }
  .meta {
    margin-top: 6px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .cover {
    width: 100%;
    max-height: 300px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-block: 20px;
    border-radius: var(--radius);
    background: var(--navy-800);
  }
  .prose {
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose > :global(p:first-child) {
    font-size: 1.12rem;
  }
  .prose :global(p) {
    margin: 0 0 1.1em;
  }
  .prose :global(h2) {
    margin: 1.7em 0 0.5em;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .prose :global(ul) {
    margin: 0 0 1.2em;
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--gold-ink);
  }
  .note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 1.4em;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: #fff8e2;
    border: 1px solid #f0dc9e;
    color: #5e4710;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .note :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }
  .section-head {
    flex-wrap: wrap;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }
  @media (min-width: 768px) {
    .article {
      padding: 36px 44px 40px;
    }
    h1 {
      font-size: 2.3rem;
    }
    .dek {
      font-size: 1.15rem;
    }
    .prose {
      font-size: 1.1rem;
    }
    .prose :global(h2) {
      font-size: 1.45rem;
    }
  }
</style>
