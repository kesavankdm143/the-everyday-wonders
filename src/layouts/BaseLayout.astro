---
import '../styles/global.css';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path after the language prefix, e.g. "" for the homepage. Used for hreflang links. */
  path?: string;
  /** Keeps a page out of search results and skips the language links. Used by the 404 page. */
  noindex?: boolean;
  /**
   * Opt in to a canonical link and full-address language alternates built from the
   * site address in astro.config.mjs. Pages that don't opt in keep the simple links.
   */
  canonical?: boolean;
  /** The languages this page exists in (used with `canonical`). */
  available?: Lang[];
  /** Open Graph type: "article" for article pages. */
  ogType?: 'website' | 'article';
  /** The day an article was published, as YYYY-MM-DD. */
  published?: string;
}

const {
  lang,
  title,
  description,
  path = '',
  noindex = false,
  canonical = false,
  available = ['en', 'ta'],
  ogType = 'website',
  published,
} = Astro.props;
const t = useTranslations(lang);

// Full web address of a path on this site (needs `site` in astro.config.mjs).
const absolute = (pathname: string) => {
  if (!Astro.site) throw new Error('Set `site` in astro.config.mjs to use canonical links.');
  return new URL(pathname, Astro.site).href;
};
const preferred: Lang = available.includes('en') ? 'en' : available[0];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1426" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    {noindex && <meta name="robots" content="noindex" />}

    <!-- Tell search engines that English and Tamil versions of this page exist -->
    {!noindex && !canonical && <link rel="alternate" hreflang="en" href={`/en/${path}`} />}
    {!noindex && !canonical && <link rel="alternate" hreflang="ta" href={`/ta/${path}`} />}
    {!noindex && !canonical && <link rel="alternate" hreflang="x-default" href={`/en/${path}`} />}
    {!noindex && canonical && <link rel="canonical" href={absolute(`/${lang}/${path}`)} />}
    {
      !noindex &&
        canonical &&
        available.map((code) => <link rel="alternate" hreflang={code} href={absolute(`/${code}/${path}`)} />)
    }
    {!noindex && canonical && <link rel="alternate" hreflang="x-default" href={absolute(`/${preferred}/${path}`)} />}

    <link rel="preload" href="/fonts/poppins-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    {
      lang === 'ta' && (
        <link rel="preload" href="/fonts/noto-sans-tamil-tamil-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'ta' ? 'ta_IN' : 'en_IN'} />
    {canonical && <meta property="og:url" content={absolute(`/${lang}/${path}`)} />}
    {published && <meta property="article:published_time" content={published} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <slot />
  </body>
</html>
