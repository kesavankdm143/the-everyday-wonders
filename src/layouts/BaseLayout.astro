---
import '../styles/global.css';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path after the language prefix, e.g. "" for the homepage. Used for hreflang links. */
  path?: string;
  /** Keeps a page out of search results and skips the language links. Used by the 404 page. */
  noindex?: boolean;
}

const { lang, title, description, path = '', noindex = false } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1426" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    {noindex && <meta name="robots" content="noindex" />}

    <!-- Tell search engines that English and Tamil versions of this page exist -->
    {!noindex && <link rel="alternate" hreflang="en" href={`/en/${path}`} />}
    {!noindex && <link rel="alternate" hreflang="ta" href={`/ta/${path}`} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={`/en/${path}`} />}

    <link rel="preload" href="/fonts/poppins-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    {
      lang === 'ta' && (
        <link rel="preload" href="/fonts/noto-sans-tamil-tamil-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'ta' ? 'ta_IN' : 'en_IN'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <slot />
  </body>
</html>
