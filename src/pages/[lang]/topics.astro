---
// /en/topics/ and /ta/topics/ — every section, and the money-and-markets guides.
import PageFrame from '../../components/PageFrame.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categoryLabel, financeTopics } from '../../data/home';
import { sectionOrder, sections } from '../../data/sections';
import { topicHref } from '../../data/topics';
import { languages, type Lang, useTranslations, otherLang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
---

<PageFrame
  lang={lang}
  title={`${t('topics.title')} — The Everyday Wonders`}
  description={t('topics.description')}
  path="topics/"
  active="topics"
>
  <Breadcrumbs
    lang={lang}
    items={[{ label: t('nav.home'), href: `/${lang}/` }, { label: t('topics.title') }]}
  />

  <section class="intro" aria-labelledby="topics-title">
    <h1 id="topics-title">{t('topics.title')}</h1>
    <p class="intro-sub" lang={other}>{useTranslations(other)('topics.title')}</p>
    <p class="intro-text">{t('topics.description')}</p>
  </section>

  <section class="panel" aria-labelledby="sections-title">
    <div class="section-head"><h2 id="sections-title">{t('topics.sections')}</h2></div>
    <ul class="grid">
      {
        sectionOrder.map((key) => (
          <li>
            <ArticleCard
              lang={lang}
              title={categoryLabel[key]}
              image={sections[key].image}
              href={`/${lang}/${key}/`}
              summary={sections[key].description[lang]}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" aria-labelledby="guides-title">
    <div class="section-head"><h2 id="guides-title">{t('finance.title')}</h2></div>
    <ul class="grid">
      {
        financeTopics.map((f) => (
          <li>
            <ArticleCard
              lang={lang}
              title={f.title}
              image={f.image}
              href={topicHref(lang, f.slug)}
              summary={f.desc[lang]}
            />
          </li>
        ))
      }
    </ul>
  </section>
</PageFrame>

<style>
  .intro {
    padding: 20px;
    border-radius: var(--radius-lg);
    background-color: var(--navy-900);
    background-image: url('/images/art/header-space.svg');
    background-size: cover;
    background-position: right center;
    box-shadow: var(--shadow);
    color: #fff;
  }
  h1 {
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .intro-sub {
    margin-top: 2px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--gold-light);
  }
  .intro-text {
    margin-top: 10px;
    max-width: 60ch;
    color: #d6deef;
  }
  .section-head {
    flex-wrap: wrap;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }
  @media (min-width: 768px) {
    .intro {
      padding: 36px 40px;
    }
    h1 {
      font-size: 2.6rem;
    }
    .intro-sub {
      font-size: 1.4rem;
    }
    .intro-text {
      font-size: 1.05rem;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }
  }
</style>
